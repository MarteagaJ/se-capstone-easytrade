    "tiles": {
      "1": {
        "content": "# 👥 EasyTrade — Customer Base \u0026 Engagement\nCustomer segmentation, login activity, and partner offer engagement.",
        "type": "markdown"
      },
      "10": {
        "query": "fetch bizevents\n| filter event.type == \"com.easytrade.offer\"\n| fieldsAdd partner = arrayElement(splitString(event.category, \"/\"), 3)\n| summarize views = count(), by:{partner}\n| sort views desc",
        "querySettings": {},
        "title": "Partner Offer Engagement",
        "type": "data",
        "visualization": "categoricalBarChart",
        "visualizationSettings": {
          "categoryAxis": {
            "label": {
              "label": "Partner",
              "showLabel": true
            }
          },
          "colorModeType": {
            "colorCategoryMode": "multi-color",
            "colorPalette": "categorical"
          },
          "dataMapping": {
            "displayedFields": [
              "partner"
            ],
            "values": [
              "views"
            ]
          },
          "numericAxis": {
            "label": {
              "label": "Offer Views",
              "showLabel": true
            }
          }
        }
      },
      "2": {
        "query": "fetch bizevents\n| filter event.type == \"com.easytrade.account\"\n| summarize total_accounts = countDistinct(accountId)",
        "querySettings": {},
        "title": "Total Accounts",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "dataMapping": {
              "value": "total_accounts"
            },
            "icon": "PersonIcon",
            "showIcon": true
          }
        }
      },
      "3": {
        "query": "fetch bizevents\n| filter event.type == \"com.easytrade.login\"\n| summarize total_logins = count()",
        "querySettings": {},
        "title": "Total Logins",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "dataMapping": {
              "value": "total_logins"
            },
            "icon": "LoginIcon",
            "showIcon": true
          }
        }
      },
      "4": {
        "query": "fetch bizevents\n| filter event.type == \"com.easytrade.offer\"\n| summarize total_offers = count()",
        "querySettings": {},
        "title": "Partner Offers Presented",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "dataMapping": {
              "value": "total_offers"
            },
            "icon": "GiftIcon",
            "showIcon": true
          }
        }
      },
      "5": {
        "query": "fetch bizevents\n| filter event.type == \"com.easytrade.offer\"\n| summarize distinct_partners = countDistinct(event.category)",
        "querySettings": {},
        "title": "Distinct Partner Offers",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "dataMapping": {
              "value": "distinct_partners"
            },
            "icon": "HandshakeIcon",
            "showIcon": true
          }
        }
      },
      "6": {
        "content": "## Customer Segmentation",
        "type": "markdown"
      },
      "7": {
        "query": "fetch bizevents\n| filter event.type == \"com.easytrade.account\"\n| summarize takeLast(packageId), by:{accountId}\n| fieldsRename tier = `takeLast(packageId)`\n| summarize accounts = count(), by:{tier}\n| sort tier asc",
        "querySettings": {},
        "title": "Customers by Package Tier",
        "type": "data",
        "visualization": "donutChart",
        "visualizationSettings": {
          "dataMapping": {
            "displayedFields": [
              "tier"
            ],
            "value": "accounts"
          },
          "labels": {
            "showLabels": true
          }
        }
      },
      "8": {
        "query": "fetch bizevents\n| filter event.type == \"com.easytrade.login\"\n| makeTimeseries logins = count(), interval: 1h",
        "querySettings": {},
        "title": "Login Activity Over Time",
        "type": "data",
        "visualization": "lineChart",
        "visualizationSettings": {
          "colorModeType": {
            "colorPalette": "categorical"
          },
          "dataMapping": {
            "interval": "interval",
            "time": "timeframe",
            "values": [
              "logins"
            ]
          }
        }
      },
      "9": {
        "content": "## Partner \u0026 Product Engagement",
        "type": "markdown"
      }
    },
