    "tiles": {
      "1": {
        "content": "# 🔎 EasyTrade — Problems, Logs \u0026 Tracing\nDavis-detected problems, log health, and exception activity across the platform — the cross-cutting reliability view.",
        "type": "markdown"
      },
      "10": {
        "query": "fetch logs\n| makeTimeseries total = count(), errors = countIf(status == \"ERROR\"), interval:5m",
        "querySettings": {},
        "title": "Log Volume \u0026 Errors Over Time",
        "type": "data",
        "visualization": "areaChart",
        "visualizationSettings": {
          "colorModeType": {
            "colorPalette": "categorical"
          },
          "dataMapping": {
            "interval": "interval",
            "time": "timeframe",
            "values": [
              "total",
              "errors"
            ]
          }
        }
      },
      "11": {
        "query": "fetch logs\n| filter status == \"ERROR\"\n| summarize occurrences = count(), by:{content}\n| sort occurrences desc\n| limit 15",
        "querySettings": {},
        "title": "Top Error Log Messages",
        "type": "data",
        "visualization": "table",
        "visualizationSettings": {
          "table": {
            "columnWidthStrategy": "content",
            "rowDensity": "condensed"
          }
        }
      },
      "12": {
        "content": "## Exceptions",
        "type": "markdown"
      },
      "13": {
        "query": "fetch spans\n| filter iAny(span.events[][span_event.name] == \"exception\")\n| expand span.events\n| fieldsFlatten span.events, fields:{exception.type}\n| summarize occurrences = count(), by:{exception.type, dt.service.name}\n| sort occurrences desc\n| limit 15",
        "querySettings": {},
        "title": "Exceptions by Service \u0026 Type",
        "type": "data",
        "visualization": "categoricalBarChart",
        "visualizationSettings": {
          "categoryAxis": {
            "label": {
              "label": "Service",
              "showLabel": true
            }
          },
          "colorModeType": {
            "colorCategoryMode": "multi-color",
            "colorPalette": "categorical"
          },
          "dataMapping": {
            "displayedFields": [
              "dt.service.name",
              "exception.type"
            ],
            "values": [
              "occurrences"
            ]
          },
          "numericAxis": {
            "label": {
              "label": "Exceptions",
              "showLabel": true
            }
          }
        }
      },
      "2": {
        "query": "fetch dt.davis.problems\n| filter not(dt.davis.is_duplicate) and event.status == \"ACTIVE\"\n| summarize count()",
        "querySettings": {},
        "title": "Active Problems",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "dataMapping": {
              "value": "count()"
            },
            "icon": "ProblemIcon",
            "showIcon": true
          }
        }
      },
      "3": {
        "query": "fetch dt.davis.problems\n| filter not(dt.davis.is_duplicate)\n| summarize count()",
        "querySettings": {},
        "title": "Problems (in view)",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "dataMapping": {
              "value": "count()"
            },
            "icon": "ListIcon",
            "showIcon": true
          }
        }
      },
      "4": {
        "query": "fetch logs\n| summarize total = count(), errors = countIf(status == \"ERROR\")\n| fieldsAdd error_rate_pct = round(errors * 100.0 / total, decimals:2)",
        "querySettings": {},
        "title": "Log Error Rate (%)",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "dataMapping": {
              "value": "error_rate_pct"
            },
            "icon": "LogIcon",
            "showIcon": true
          }
        }
      },
      "5": {
        "query": "fetch spans\n| filter iAny(span.events[][span_event.name] == \"exception\")\n| summarize count()",
        "querySettings": {},
        "title": "Exceptions (in view)",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "dataMapping": {
              "value": "count()"
            },
            "icon": "BugIcon",
            "showIcon": true
          }
        }
      },
      "6": {
        "content": "## Problem History",
        "type": "markdown"
      },
      "7": {
        "query": "fetch dt.davis.problems\n| filter not(dt.davis.is_duplicate)\n| summarize count(), by:{event.category}",
        "querySettings": {},
        "title": "Problems by Category",
        "type": "data",
        "visualization": "donutChart",
        "visualizationSettings": {
          "dataMapping": {
            "displayedFields": [
              "event.category"
            ],
            "value": "count()"
          },
          "labels": {
            "showLabels": true
          }
        }
      },
      "8": {
        "query": "fetch dt.davis.problems\n| filter not(dt.davis.is_duplicate)\n| fields event.start, display_id, event.name, event.category, event.status\n| sort event.start desc\n| limit 20",
        "querySettings": {},
        "title": "Recent Problems",
        "type": "data",
        "visualization": "table",
        "visualizationSettings": {
          "table": {
            "columnWidthStrategy": "content",
            "rowDensity": "condensed"
          }
        }
      },
      "9": {
        "content": "## Log Health",
        "type": "markdown"
      }
