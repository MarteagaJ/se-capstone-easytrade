    "tiles": {
      "1": {
        "content": "# 🖥️ EasyTrade — Infrastructure \u0026 Kubernetes Health\nHost and container resource usage across the `local-wsl-capstone` cluster, sourced from OneAgent host and Kubernetes metrics.",
        "type": "markdown"
      },
      "10": {
        "content": "## Container Resource Usage by Workload",
        "type": "markdown"
      },
      "11": {
        "query": "timeseries cpu = avg(dt.kubernetes.container.cpu_usage, scalar:true), by:{k8s.workload.name, k8s.namespace.name}\n| filter k8s.namespace.name == \"easytrade\"\n| fields k8s.workload.name, cpu\n| sort cpu desc\n| limit 10",
        "querySettings": {},
        "title": "Container CPU by Workload (%)",
        "type": "data",
        "visualization": "categoricalBarChart",
        "visualizationSettings": {
          "categoryAxis": {
            "label": {
              "label": "Workload",
              "showLabel": true
            }
          },
          "colorModeType": {
            "colorCategoryMode": "multi-color",
            "colorPalette": "categorical"
          },
          "dataMapping": {
            "displayedFields": [
              "k8s.workload.name"
            ],
            "values": [
              "cpu"
            ]
          },
          "numericAxis": {
            "label": {
              "label": "CPU Usage (%)",
              "showLabel": true
            }
          }
        }
      },
      "12": {
        "query": "timeseries mem_bytes = avg(dt.kubernetes.container.memory_working_set, scalar:true), by:{k8s.workload.name, k8s.namespace.name}\n| filter k8s.namespace.name == \"easytrade\"\n| fieldsAdd mem_mb = round(mem_bytes / 1024 / 1024, decimals:1)\n| fields k8s.workload.name, mem_mb\n| sort mem_mb desc\n| limit 10",
        "querySettings": {},
        "title": "Container Memory by Workload (MB)",
        "type": "data",
        "visualization": "categoricalBarChart",
        "visualizationSettings": {
          "categoryAxis": {
            "label": {
              "label": "Workload",
              "showLabel": true
            }
          },
          "colorModeType": {
            "colorCategoryMode": "multi-color",
            "colorPalette": "categorical"
          },
          "dataMapping": {
            "displayedFields": [
              "k8s.workload.name"
            ],
            "values": [
              "mem_mb"
            ]
          },
          "numericAxis": {
            "label": {
              "label": "Memory (MB)",
              "showLabel": true
            }
          }
        }
      },
      "13": {
        "content": "## Cluster Composition \u0026 Stability",
        "type": "markdown"
      },
      "14": {
        "query": "smartscapeNodes \"K8S_POD\"\n| summarize pods = count(), by:{k8s.namespace.name}",
        "querySettings": {},
        "title": "Pod Distribution by Namespace",
        "type": "data",
        "visualization": "donutChart",
        "visualizationSettings": {
          "dataMapping": {
            "displayedFields": [
              "k8s.namespace.name"
            ],
            "value": "pods"
          },
          "labels": {
            "showLabels": true
          }
        }
      },
      "15": {
        "query": "timeseries restarts = sum(dt.kubernetes.container.restarts, scalar:true), by:{k8s.workload.name, k8s.namespace.name}\n| filter restarts \u003e 0\n| fields k8s.namespace.name, k8s.workload.name, restarts\n| sort restarts desc\n| limit 10",
        "querySettings": {},
        "title": "Workloads with Restarts",
        "type": "data",
        "visualization": "table",
        "visualizationSettings": {
          "table": {
            "columnWidthStrategy": "content",
            "rowDensity": "condensed"
          }
        }
      },
      "2": {
        "query": "timeseries cpu = avg(dt.host.cpu.usage, scalar:true)",
        "querySettings": {},
        "title": "Host CPU (%)",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "dataMapping": {
              "value": "cpu"
            },
            "icon": "CpuIcon",
            "showIcon": true
          }
        }
      },
      "3": {
        "query": "timeseries mem = avg(dt.host.memory.usage, scalar:true)",
        "querySettings": {},
        "title": "Host Memory (%)",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "dataMapping": {
              "value": "mem"
            },
            "icon": "MemoryIcon",
            "showIcon": true
          }
        }
      },
      "4": {
        "query": "smartscapeNodes \"K8S_POD\"\n| filter k8s.namespace.name == \"easytrade\"\n| summarize count()",
        "querySettings": {},
        "title": "Pods Running",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "dataMapping": {
              "value": "count()"
            },
            "icon": "KubernetesIcon",
            "showIcon": true
          }
        }
      },
      "5": {
        "query": "smartscapeNodes \"K8S_POD\"\n| filter k8s.namespace.name == \"easytrade\"\n| summarize workloads = countDistinct(k8s.workload.name)",
        "querySettings": {},
        "title": "Workloads",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "dataMapping": {
              "value": "workloads"
            },
            "icon": "AppIcon",
            "showIcon": true
          }
        }
      },
      "6": {
        "query": "timeseries restarts = sum(dt.kubernetes.container.restarts, scalar:true)",
        "querySettings": {},
        "title": "Container Restarts",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "dataMapping": {
              "value": "restarts"
            },
            "icon": "RefreshIcon",
            "showIcon": true
          }
        }
      },
      "7": {
        "query": "timeseries oom = sum(dt.kubernetes.container.oom_kills, scalar:true)",
        "querySettings": {},
        "title": "OOM Kills",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "dataMapping": {
              "value": "oom"
            },
            "icon": "WarningIcon",
            "showIcon": true
          }
        }
      },
      "8": {
        "content": "## Host Resource Usage",
        "type": "markdown"
      },
      "9": {
        "query": "timeseries {cpu = avg(dt.host.cpu.usage), mem = avg(dt.host.memory.usage)}, by:{dt.smartscape.host}",
        "querySettings": {},
        "title": "Host CPU \u0026 Memory Over Time",
        "type": "data",
        "visualization": "areaChart",
        "visualizationSettings": {
          "colorModeType": {
            "colorPalette": "categorical"
          },
          "dataMapping": {
            "interval": "interval",
            "names": [
              "dt.smartscape.host"
            ],
            "time": "timeframe",
            "values": [
              "cpu",
              "mem"
            ]
          }
        }
      }
    },
